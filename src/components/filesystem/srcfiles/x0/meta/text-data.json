    "TXT.CARD.GAME-START.TEXT": {
        "id": "TXT.CARD.GAME-START.TEXT",
        "group": "card-text",
        "value_de": "Über den Button „Spiel starten“ wird das PONG-Spiel auf dem ESP32 gestartet. Es kommt hierbei auf die per WLAN angemeldete Benutzeranzahl an (siehe PONG-Titelscreen „P1:“ und „P2:“). Bei einem (1) angemeldeten WLAN-Client wird das Spiel im KI-Modus gestartet, ansonsten spielt man gegeneinander.",
        "value_en": "Clicking the 'Start Game' button launches the PONG game on the ESP32. The mode depends on the number of users connected via Wi-Fi (see the PONG title screen 'P1:' and 'P2:'). If only one (1) Wi-Fi client is connected, the game starts in AI mode; otherwise, players compete against each other.",
        "orderby": 1
    },
