    },
    "TXT.CARD.GAME-MOVEMENT.TEXT": {
        "id": "TXT.CARD.GAME-MOVEMENT.TEXT",
        "group": "card-text",
        "value_de": "Die folgenden zwei Buttons steuern die Schlägerbewegung, sobald das Spiel gestartet ist. Der Schläger von Spieler 1 (KI oder Mensch) befindet sich auf der linken Seite, der Schläger von Spieler 2 auf der rechten Seite. Das Drücken der „Hoch“- oder „Runter“-Taste bewegt den Schläger in die gewählte Richtung, bis die entgegengesetzte Richtungstaste gedrückt wird.",
        "value_en": "The following two buttons control your paddle's movement once the game starts. Player 1's paddle (AI or human) is on the left, and Player 2's paddle is on the right. Pressing either the 'Up' or 'Down' button moves the paddle in that direction until you press the opposite direction button.",
        "orderby": 1
    },
    "TXT.BUTTON.GAME.PADDLE-UP": {
